model AuditLog {
  id           String   @id @default(uuid())
  userId       String
  action       String
  resourceType String?  @default("")
  resourceId   String?  @default("")
  details      Json?    @default("{}")
  ipAddress    String?  @default("")
  userAgent    String?  @default("")
  companyId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company? @relation(fields: [companyId], references: [id])
  user         User     @relation("UserAuditLogs", fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@index([companyId])
}

model AiRequestLog {
  id                   String           @id @default(uuid())
  calendarId           String?
  userId               String?
  inputParameters      Json?            @default("{}")
  aiResponseTimeMs     Int              @default(0)
  totalPiecesGenerated Int              @default(0)
  qualityScore         Float            @default(0)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  calendar             ContentCalendar? @relation(fields: [calendarId], references: [id])
  user                 User?            @relation("AiRequestLogs", fields: [userId], references: [id])
}

model AutomationLog {
  id               String   @id @default(uuid())
  eventType        String
  triggeredById    String?
  targetUserId     String?
  targetClientId   String?
  relatedItemModel String?
  relatedItemId    String?
  description      String?
  status           String   @default("success")
  error            String?
  metadata         Json?    @default("{}")
  timestamp        DateTime @default(now())
  companyId        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  company          Company? @relation("CompanyAutomationLogs", fields: [companyId], references: [id])
  targetUser       User?    @relation("AutomationTargetUser", fields: [targetUserId], references: [id])
  triggeredBy      User?    @relation("AutomationTriggered", fields: [triggeredById], references: [id])

  @@index([eventType, timestamp(sort: Desc)])
  @@index([companyId])
  @@index([companyId, status])
}

model PlatformSettings {
  id                       String   @id @default(uuid())
  platformName             String   @default("IMS")
  maintenanceMode          Boolean  @default(false)
  maintenanceMessage       String   @default("System is under maintenance. Please try again shortly.")
  defaultPlanId            String?
  maxFreeUsers             Int      @default(5)
  supportEmail             String   @default("")
  logoUrl                  String   @default("")
  faviconUrl               String   @default("")
  currency                 String   @default("USD")
  paymentConfig            Json?    @default("{}")
  paymentsEnabled          Boolean  @default(false)
  platformApiUrl           String   @default("")
  smtpHost                 String?
  smtpPort                 Int?
  smtpUser                 String?
  smtpPass                 String?
  smtpFrom                 String?
  smtpSecure               Boolean  @default(false)
  allowSelfRegistration    Boolean  @default(true)
  trialDays                Int      @default(14)
  dataRetentionDays        Int      @default(30)
  trialMandateAmount       Int      @default(100)
  maxAutopayRetries        Int      @default(3)
  autopayRetryIntervalDays Int      @default(3)
  superAdminDbUri          String?
  brandingTagline          String   @default("")
  themeColor               String   @default("#4f46e5")
  companyLegalName         String   @default("")
  companyAddress           String   @default("")
  companyPhone             String   @default("")
  companyWebsite           String   @default("")
  dbHost                   String?
  dbPort                   Int?
  dbUser                   String?
  dbPass                   String?
  dbName                   String?
  dbSrv                    Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model Plan {
  id            String         @id @default(uuid())
  planName      String
  price         Float
  currency      String         @default("INR")
  billingCycle  String         @default("monthly")
  maxUsers      Int            @default(10)
  features      String[]
  isActive      Boolean        @default(true)
  trialDays     Int            @default(14)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id                     String           @id @default(uuid())
  companyId              String
  planId                 String
  status                 String           @default("trial")
  provider               String           @default("none")
  providerSubscriptionId String?
  providerOrderId        String?
  providerCustomerId     String?
  mandateStatus          String           @default("pending")
  mandateAmount          Int              @default(100)
  autopayEnabled         Boolean          @default(false)
  autopayFailCount       Int              @default(0)
  autopayLastFailedAt    DateTime?
  autopayPausedAt        DateTime?
  cancelReason           String?
  cancelledAt            DateTime?
  trialStartDate         DateTime?
  trialEndDate           DateTime?
  subscriptionStartDate  DateTime?
  subscriptionEndDate    DateTime?
  startDate              DateTime         @default(now())
  renewalDate            DateTime?
  nextChargeDate         DateTime?
  paymentId              String?
  paymentStatus          String           @default("pending")
  amount                 Float
  currency               String           @default("INR")
  couponApplied          String?
  discountAmount         Float            @default(0)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  remindersSent          Json?            @default("[]")
  paymentHistories       PaymentHistory[]
  plan                   Plan             @relation(fields: [planId], references: [id])

  @@index([companyId, status])
  @@index([companyId])
}

model Coupon {
  id            String    @id @default(uuid())
  couponCode    String    @unique
  discountType  String    @default("percentage")
  discountValue Float
  maxUses       Int?
  usedCount     Int       @default(0)
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model PaymentHistory {
  id                String       @id @default(uuid())
  paymentId         String       @unique
  companyId         String
  subscriptionId    String
  amount            Float
  currency          String       @default("INR")
  provider          String
  providerPaymentId String
  status            String
  rawWebhookData    Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([companyId])
}

model SuperAdmin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("superadmin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DeletionLog {
  id           String   @id @default(uuid())
  companyId    String
  initiatedBy  String
  deletionDate DateTime @default(now())
  status       String   @default("completed")
  errorReason  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([companyId])
}

model FeatureFlag {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isEnabled   Boolean  @default(false)
  rules       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Announcement {
  id        String    @id @default(uuid())
  title     String
  content   String
  target    String    @default("all")
  isActive  Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ReleaseNote {
  id          String   @id @default(uuid())
  version     String   @unique
  title       String
  content     String
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SupportTicket {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  subject   String
  message   String
  messages  Json?    @default("[]")
  status    String   @default("open")
  priority  String   @default("medium")
  category  String   @default("technical")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([companyId])
}

model AiChatSession {
  id        String          @id @default(uuid())
  userId    String
  title     String          @default("New Chat")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  messages  AiChatMessage[]
  user      User            @relation("UserAiChatSessions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AiChatMessage {
  id        String        @id @default(uuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime      @default(now())
  session   AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Dispute {
  id          String   @id @default(uuid())
  userId      String
  description String
  images      Json?    @default("[]")
  status      String   @default("pending")
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation("UserDisputes", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId])
}
