model Company {
  id                                            String                @id @default(uuid())
  name                                          String
  slug                                          String?               @unique
  logoUrl                                       String?
  bannerUrl                                     String?
  oneLineDescription                            String?
  industry                                      String?
  startupStage                                  String?
  teamSize                                      String?
  country                                       String?
  website                                       String?
  foundedDate                                   DateTime?
  companyType                                   String?
  tagline                                       String?
  headquarters                                  String?
  otherOffices                                  String?
  aboutUs                                       String?
  vision                                        String?
  mission                                       String?
  story                                         String?
  coreValues                                    Json?                 @default("[]")
  socialLinks                                   Json?                 @default("{}")
  totalFunding                                  String?
  fundingStage                                  String?
  businessStatus                                String?
  burnRate                                      String?
  runway                                        String?
  annualRevenue                                 String?
  revenueGrowth                                 String?
  lastRound                                     String?
  lastValued                                    String?
  leadInvestor                                  String?
  productsBuilt                                 String?
  happyClients                                  String?
  countriesActive                               String?
  awardsCount                                   String?
  topRecognition                                String?
  companyHighlights                             Json?                 @default("[]")
  profileViews                                  Int                   @default(0)
  followersCount                                Int                   @default(0)
  privacySettings                               Json?                 @default("{}")
  ownerId                                       String?
  createdAt                                     DateTime              @default(now())
  updatedAt                                     DateTime              @updatedAt
  auditLogs                                     AuditLog[]
  automationLogs_CompanyAutomationLogs          AutomationLog[]       @relation("CompanyAutomationLogs")
  owner                                         User?                 @relation("CompanyOwner", fields: [ownerId], references: [id])
  coreValueItems                                CompanyCoreValue[]
  followersList                                 CompanyFollower[]     @relation("CompanyFollowers")
  investors                                     CompanyInvestor[]
  media                                         CompanyMedia[]
  products                                      CompanyProduct[]
  publicReviews                                 CompanyPublicReview[] @relation("CompanyPublicReviews")
  services                                      CompanyService[]
  contentCalendars_CompanyContentCalendars      ContentCalendar[]     @relation("CompanyContentCalendars")
  deletionLogs                                  DeletionLog[]
  documents_CompanyDocuments                    Document[]            @relation("CompanyDocuments")
  emailLogs_CompanyEmailLogs                    EmailLog[]            @relation("CompanyEmailLogs")
  events_CompanyEvents                          Event[]               @relation("CompanyEvents")
  jobs_CompanyJobs                              Job[]                 @relation("CompanyJobs")
  jobApplications_CompanyJobApplications        JobApplication[]      @relation("CompanyJobApplications")
  jobCandidateProfiles_CompanyCandidateProfiles JobCandidateProfile[] @relation("CompanyCandidateProfiles")
  jobOpportunitys_CompanyJobOpportunities       JobOpportunity[]      @relation("CompanyJobOpportunities")
  meetingLogs_CompanyMeetingLogs                MeetingLog[]          @relation("CompanyMeetingLogs")
  serviceRequests                               ServiceRequest[]
  Settings                                      Settings?
  supportTickets                                SupportTicket[]
  users                                         User[]                @relation("CompanyUsers")
}

model CompanyCoreValue {
  id          String   @id @default(uuid())
  companyId   String
  title       String
  description String
  iconUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model CompanyPublicReview {
  id          String   @id @default(uuid())
  companyId   String
  userId      String
  rating      Float
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation("CompanyPublicReviews", fields: [companyId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
}

model CompanyFollower {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  createdAt DateTime @default(now())
  company   Company  @relation("CompanyFollowers", fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation("UserFollowingCompanies", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
}

model Job {
  id              String        @id @default(uuid())
  title           String
  description     String        @default("")
  department      String        @default("")
  location        String        @default("")
  type            String        @default("full-time")
  status          String        @default("draft")
  requirements    String        @default("")
  roleCategory    String        @default("Engineering")
  openings        Int           @default(1)
  deadline        DateTime?
  skills          String[]      @default([])
  customFields    Json?         @default("[]")
  benefits        String[]      @default([])
  salaryRangeMin  Int?
  salaryRangeMax  Int?
  isRemote        Boolean       @default(false)
  experienceLevel String        @default("Entry Level")
  workModel       String        @default("On-site")
  currency        String        @default("INR")
  companyId       String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  applications    Application[]
  company         Company       @relation("CompanyJobs", fields: [companyId], references: [id])

  @@index([companyId, status])
}

model Application {
  id             String       @id @default(uuid())
  jobId          String
  applicantName  String
  applicantEmail String
  userId         String?
  phone          String       @default("")
  resumeUrl      String       @default("")
  coverLetter    String       @default("")
  customFields   Json?        @default("{}")
  status         String       @default("applied")
  notes          String       @default("")
  reviewedById   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reviewedBy     User?        @relation("UserApplicationsReviewed", fields: [reviewedById], references: [id])
  user           User?        @relation("UserApplicationsApplied", fields: [userId], references: [id])
  onboardings    Onboarding[]

  @@index([jobId, status])
  @@index([applicantEmail])
}

model JobApplication {
  id                    String              @id @default(uuid())
  candidateProfileId    String
  jobOpportunityId      String
  userId                String
  matchScore            Float               @default(0)
  missingSkills         String[]            @default([])
  customizedResumeUrl   String              @default("")
  customizedCoverLetter String              @default("")
  status                String              @default("Pending")
  appliedDate           DateTime?
  emailThreadId         String              @default("")
  deletedAt             DateTime?
  companyId             String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  candidateProfile      JobCandidateProfile @relation(fields: [candidateProfileId], references: [id])
  company               Company?            @relation("CompanyJobApplications", fields: [companyId], references: [id])
  jobOpportunity        JobOpportunity      @relation(fields: [jobOpportunityId], references: [id])
  user                  User                @relation("UserJobApplications", fields: [userId], references: [id])

  @@index([companyId, status])
  @@index([companyId])
}

model JobCandidateProfile {
  id              String           @id @default(uuid())
  userId          String
  headline        String           @default("")
  summary         String           @default("")
  skills          String[]         @default([])
  experience      Json?            @default("[]")
  education       Json?            @default("[]")
  projects        Json?            @default("[]")
  preferences     Json?            @default("{}")
  gmailConnected  Boolean          @default(false)
  credits         Int              @default(10)
  deletedAt       DateTime?
  companyId       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  jobApplications JobApplication[]
  company         Company?         @relation("CompanyCandidateProfiles", fields: [companyId], references: [id])
  user            User             @relation("UserCandidateProfiles", fields: [userId], references: [id])

  @@index([companyId])
}

model JobOpportunity {
  id              String           @id @default(uuid())
  title           String
  description     String           @default("")
  sourceUrl       String           @default("")
  hrEmail         String           @default("")
  salaryRangeMin  Int?
  salaryRangeMax  Int?
  salaryCurrency  String           @default("USD")
  location        String           @default("")
  workType        String           @default("Unknown")
  sourcePlatform  String           @default("Manual")
  deletedAt       DateTime?
  companyId       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  jobApplications JobApplication[]
  company         Company?         @relation("CompanyJobOpportunities", fields: [companyId], references: [id])
  savedBy         SavedJob[]

  @@index([companyId])
}

model SavedJob {
  id        String    @id @default(uuid())
  userId    String
  jobId     String
  createdAt DateTime  @default(now())
  user      User      @relation("UserSavedJobs", fields: [userId], references: [id], onDelete: Cascade)
  job       JobOpportunity @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model Onboarding {
  id                    String       @id @default(uuid())
  employeeId            String       @unique
  recruitmentId         String?
  step                  Int          @default(1)
  status                String       @default("pending")
  personalInfo          Json?        @default("{}")
  documents             Json?        @default("{}")
  welcomeAcknowledgedAt DateTime?
  completedAt           DateTime?
  notes                 String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  employee              User         @relation("UserOnboardings", fields: [employeeId], references: [id])
  recruitment           Application? @relation(fields: [recruitmentId], references: [id])

  @@index([status])
}

model CompanyService {
  id                  String           @id @default(uuid())
  companyId           String
  name                String
  description         String?
  startingPrice       String?
  icon                String?
  imageUrl            String?
  detailedDescription String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  company             Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requests            ServiceRequest[]

  @@index([companyId])
}

model CompanyProduct {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  description String?
  link        String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model CompanyMedia {
  id        String   @id @default(uuid())
  companyId String
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model CompanyInvestor {
  id        String   @id @default(uuid())
  companyId String
  name      String
  type      String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}
