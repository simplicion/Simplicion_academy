model PitchinGig {
  id          String   @id @default(uuid())
  headline    String
  budget      String
  timeline    String
  description String
  contactInfo String?
  skills      String[] @default([])
  postedById  String
  status      String   @default("open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  postedBy    User     @relation("UserPitchinGigs", fields: [postedById], references: [id])
  savedBy     SavedGig[]
  
  @@index([postedById])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model SavedGig {
  id        String    @id @default(uuid())
  userId    String
  gigId     String
  createdAt DateTime  @default(now())
  user      User      @relation("UserSavedGigs", fields: [userId], references: [id], onDelete: Cascade)
  gig       PitchinGig @relation(fields: [gigId], references: [id], onDelete: Cascade)

  @@unique([userId, gigId])
}
