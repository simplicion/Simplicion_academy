model ForumPost {
  id             String       @id @default(uuid())
  authorUserId   String
  title          String
  content        String
  category       String       @default("general")
  tags           String[]     @default([])
  viewCount      Int          @default(0)
  replyCount     Int          @default(0)
  isPinned       Boolean      @default(false)
  isLocked       Boolean      @default(false)
  status         String       @default("active")
  upvotes        String[]     @default([])
  postType       String       @default("general")
  mediaUrls      Json?
  rawVideoUrl    String?
  hlsUrl         String?
  thumbnailUrl   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  authorCompany  String?
  authorName     String?
  authorPhotoUrl String?
  authorUser     User         @relation("UserForumPosts", fields: [authorUserId], references: [id])
  replies        ForumReply[]
  pollOptions    PollOption[]
  reports        PostReport[]
  savedBy        SavedPost[]
  hashtags       Hashtag[]    @relation("ForumPostToHashtag")
  mentions       User[]       @relation("PostMentions")

  @@index([createdAt(sort: Desc)])
  @@index([category])
  @@index([authorUserId])
  @@index([status])
}

model ForumReply {
  id             String       @id @default(uuid())
  postId         String
  authorUserId   String
  content        String
  parentReplyId  String?
  upvotes        String[]     @default([])
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  authorCompany  String?
  authorName     String?
  authorPhotoUrl String?
  authorUser     User         @relation("UserForumReplies", fields: [authorUserId], references: [id])
  parentReply    ForumReply?  @relation("NestedReplies", fields: [parentReplyId], references: [id])
  childReplies   ForumReply[] @relation("NestedReplies")
  post           ForumPost    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([createdAt])
  @@index([status])
}

model SavedPost {
  id        String    @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime  @default(now())
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation("UserSavedPosts", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

model Hashtag {
  id        String      @id @default(uuid())
  name      String      @unique
  createdAt DateTime    @default(now())
  posts     ForumPost[] @relation("ForumPostToHashtag")
}

model PollOption {
  id        String     @id @default(uuid())
  text      String
  votes     Int        @default(0)
  postId    String
  post      ForumPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  pollVotes PollVote[]
}

model PostReport {
  id         String    @id @default(uuid())
  postId     String
  reporterId String
  reason     String
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  post       ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter   User      @relation("UserPostReports", fields: [reporterId], references: [id], onDelete: Cascade)
}

model PollVote {
  id           String     @id @default(uuid())
  pollOptionId String
  userId       String
  createdAt    DateTime   @default(now())
  pollOption   PollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)
  user         User       @relation("UserPollVotes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollOptionId, userId])
}
