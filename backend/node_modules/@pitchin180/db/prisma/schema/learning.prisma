model LearningPath {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String?
  category    String   @default("Startup Growth")
  level       String   @default("Beginner")
  icon        String?
  bannerUrl   String?
  isPublished Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  courses     Course[]
  tracks      Track[]
}

model Track {
  id             String        @id @default(uuid())
  learningPathId String?
  title          String
  slug           String        @unique
  description    String?
  estimatedHours Int           @default(10)
  order          Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  courses        Course[]
  learningPath   LearningPath? @relation(fields: [learningPathId], references: [id])
}

model Course {
  id               String         @id @default(uuid())
  learningPathId   String?
  trackId          String?
  title            String
  slug             String         @unique
  subtitle         String?
  description      String
  category         String         @default("General")
  level            String         @default("All Levels")
  instructorName   String         @default("Pitchin Academy")
  instructorRole   String         @default("Industry Specialist")
  instructorImage  String?
  thumbnailUrl     String?
  bannerUrl        String?
  estimatedMinutes Int            @default(60)
  tags             String[]       @default([])
  isPublished      Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  certificates     Certificate[]
  competencies     Competency[]
  learningPath     LearningPath?  @relation(fields: [learningPathId], references: [id])
  track            Track?         @relation(fields: [trackId], references: [id])
  modules          CourseModule[]
  enrollments      Enrollment[]

  @@index([category])
  @@index([isPublished])
}

model CourseModule {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@index([courseId])
}

model Lesson {
  id               String           @id @default(uuid())
  moduleId         String
  title            String
  slug             String           @default("")
  content          String
  contentType      String           @default("text")
  videoUrl         String?
  durationMinutes  Int              @default(10)
  order            Int              @default(0)
  isFreePreview    Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  assessments      Assessment[]
  module           CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessonProgresses LessonProgress[]

  @@index([moduleId])
}

model Assessment {
  id           String                 @id @default(uuid())
  lessonId     String?
  title        String
  description  String?
  passingScore Int                    @default(80)
  type         String                 @default("quiz")
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  lesson       Lesson?                @relation(fields: [lessonId], references: [id])
  submissions  AssessmentSubmission[]
  questions    QuizQuestion[]
}

model QuizQuestion {
  id           String     @id @default(uuid())
  assessmentId String
  question     String
  options      Json
  correctIndex Int
  explanation  String?
  order        Int        @default(0)
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

model AssessmentSubmission {
  id           String     @id @default(uuid())
  assessmentId String
  userId       String
  score        Int
  passed       Boolean
  answers      Json
  submittedAt  DateTime   @default(now())
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([assessmentId, userId])
}

model Enrollment {
  id          String    @id @default(uuid())
  userId      String
  courseId    String
  progress    Float     @default(0)
  status      String    @default("in_progress")
  completedAt DateTime?
  enrolledAt  DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model LessonProgress {
  id          String   @id @default(uuid())
  userId      String
  lessonId    String
  isCompleted Boolean  @default(true)
  completedAt DateTime @default(now())
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

model Certificate {
  id               String            @id @default(uuid())
  courseId         String
  title            String
  description      String?
  templateUrl      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  course           Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userCertificates UserCertificate[]
}

model UserCertificate {
  id            String      @id @default(uuid())
  userId        String
  certificateId String
  certificateNo String      @unique @default(uuid())
  issuedAt      DateTime    @default(now())
  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Competency {
  id          String   @id @default(uuid())
  courseId    String
  name        String
  description String?
  skillTag    String
  createdAt   DateTime @default(now())
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model UserBadge {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String
  imageUrl    String
  earnedAt    DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
