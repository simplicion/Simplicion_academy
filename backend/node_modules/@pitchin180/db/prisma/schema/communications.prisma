model Chat {
  id             String    @id @default(uuid())
  isGroup        Boolean   @default(false)
  name           String    @default("")
  description    String    @default("")
  avatar         String    @default("")
  createdById    String?
  lastMessageId  String?
  lastActivity   DateTime  @default(now())
  isMuted        Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      User?     @relation("ChatCreator", fields: [createdById], references: [id])
  lastMessage    Message?  @relation("ChatLastMessage", fields: [lastMessageId], references: [id])
  messages       Message[] @relation("ChatMessages")
  admins         User[]    @relation("ChatAdmins")
  members        User[]    @relation("ChatMembers")
  pinnedMessages Message[] @relation("PinnedMessages")
}

model Message {
  id                         String    @id @default(uuid())
  chatId                     String
  senderId                   String
  content                    String    @default("")
  attachmentUrl              String    @default("")
  attachmentType             String    @default("none")
  replyToId                  String?
  reactions                  Json?     @default("{}")
  isSystem                   Boolean   @default(false)
  isEdited                   Boolean   @default(false)
  deletedAt                  DateTime?
  deletedById                String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  chatsWithThisLastMessage   Chat[]    @relation("ChatLastMessage")
  chat                       Chat      @relation("ChatMessages", fields: [chatId], references: [id], onDelete: Cascade)
  deletedBy                  User?     @relation("MessageDeletedBy", fields: [deletedById], references: [id])
  replyTo                    Message?  @relation("MessageReplies", fields: [replyToId], references: [id])
  replies                    Message[] @relation("MessageReplies")
  sender                     User      @relation("MessageSender", fields: [senderId], references: [id])
  mentions                   User[]    @relation("MessageMentions")
  readBy                     User[]    @relation("MessageReadBy")
  starredBy                  User[]    @relation("MessageStarredBy")
  chatsWithThisPinnedMessage Chat[]    @relation("PinnedMessages")

  @@index([chatId, createdAt(sort: Desc)])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("system")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("UserNotification", fields: [userId], references: [id])
}

model EmailLog {
  id           String   @id @default(uuid())
  to           String
  subject      String
  templateName String
  templateData Json?    @default("{}")
  sentById     String?
  status       String   @default("sent")
  errorMessage String?
  companyId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company? @relation("CompanyEmailLogs", fields: [companyId], references: [id])
  sentBy       User?    @relation("UserEmailLogs", fields: [sentById], references: [id])

  @@index([createdAt(sort: Desc)])
  @@index([companyId])
  @@index([companyId, status])
}
