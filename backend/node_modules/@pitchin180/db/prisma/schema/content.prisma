model Note {
  id          String   @id @default(uuid())
  content     String
  createdById String
  relatedType String?
  relatedId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation("NoteCreator", fields: [createdById], references: [id])
}

model Settings {
  id                           String   @id @default(uuid())
  companyId                    String   @unique
  companyName                  String   @default("")
  logoUrl                      String   @default("")
  themeColor                   String   @default("#4f46e5")
  storageMode                  String   @default("r2")
  salesConfig                  Json?
  recruitmentApiKey            String?
  authorizedRecruitmentDomains String[] @default([])
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  company                      Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model CalendarContentPiece {
  id                                         String          @id @default(uuid())
  calendarId                                 String
  weekNumber                                 Int             @default(1)
  dateScheduled                              DateTime?
  platform                                   String          @default("")
  contentType                                String          @default("")
  pillar                                     String          @default("")
  headline                                   String          @default("")
  adCopyFull                                 String          @default("")
  videoScriptOrHooks                         String          @default("")
  callToAction                               String          @default("")
  hashtagsResearched                         String          @default("")
  visualAssetsBrief                          String          @default("")
  engagementTargetEstimatedImpressions       String          @default("")
  engagementTargetEstimatedEngagementPercent Float           @default(0)
  engagementTargetEstimatedShares            String          @default("")
  postingTimeTz                              String          @default("")
  notes                                      String          @default("")
  status                                     String          @default("ready")
  viralScore                                 Float           @default(5)
  performanceData                            Json?           @default("{}")
  createdAt                                  DateTime        @default(now())
  updatedAt                                  DateTime        @updatedAt
  calendar                                   ContentCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@index([status])
}

model CalendarTemplate {
  id                       String   @id @default(uuid())
  userId                   String?
  templateName             String
  industry                 String   @default("")
  platformPresets          String[] @default([])
  defaultPillars           String[] @default([])
  defaultTone              String   @default("")
  contentMixRatioReels     Float    @default(0)
  contentMixRatioPosts     Float    @default(0)
  contentMixRatioCarousels Float    @default(0)
  usageCount               Int      @default(0)
  isPublic                 Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  user                     User?    @relation("CalendarTemplates", fields: [userId], references: [id])
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContentCalendar {
  id                    String                 @id @default(uuid())
  companyId             String
  clientId              String?
  projectId             String?
  name                  String
  description           String                 @default("")
  startDate             DateTime?
  endDate               DateTime?
  contentPillars        String[]               @default([])
  tone                  String                 @default("")
  engagementGoal        String                 @default("")
  hashtagStrategy       String                 @default("")
  competitors           String[]               @default([])
  status                String                 @default("draft")
  isTemplate            Boolean                @default(false)
  templateName          String                 @default("")
  totalPieces           Int                    @default(0)
  reelsCount            Int                    @default(0)
  postsCount            Int                    @default(0)
  carouselsCount        Int                    @default(0)
  metadata              Json?                  @default("{}")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  aiRequestLogs         AiRequestLog[]
  calendarContentPieces CalendarContentPiece[]
  company               Company                @relation("CompanyContentCalendars", fields: [companyId], references: [id])

  @@index([companyId, status])
}

model Document {
  id             String    @id @default(uuid())
  name           String
  fileUrl        String
  fileId         String    @default("")
  isLinkOnly     Boolean   @default(false)
  storageType    String    @default("r2")
  fileType       String    @default("")
  fileSize       Int       @default(0)
  folder         String    @default("general")
  category       String    @default("General")
  tags           String[]  @default([])
  isConfidential Boolean   @default(false)
  uploadedById   String
  relatedId      String?
  relatedModel   String    @default("")
  description    String    @default("")
  taggedUsers    String[]  @default([])
  deletedAt      DateTime?
  companyId      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  company        Company?  @relation("CompanyDocuments", fields: [companyId], references: [id])
  uploadedBy     User      @relation("UserDocuments", fields: [uploadedById], references: [id])

  @@index([uploadedById])
  @@index([relatedId, relatedModel])
  @@index([folder])
  @@index([companyId])
}

model DocumentPage {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  category    String   @default("Other")
  content     String
  published   Boolean  @default(true)
  createdById String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation("UserDocumentPagesCreated", fields: [createdById], references: [id])
  updatedBy   User?    @relation("UserDocumentPagesUpdated", fields: [updatedById], references: [id])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  details   Json?
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("UserActivityLogs", fields: [userId], references: [id], onDelete: Cascade)
}

model ServiceRequest {
  id                   String         @id @default(uuid())
  serviceId            String
  companyId            String
  requesterName        String?
  requesterEmail       String
  requesterCompanyName String?
  companySize          String?
  requirements         String
  budgetRange          String?
  timeline             String?
  status               String         @default("pending")
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  company              Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  service              CompanyService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([serviceId])
}
