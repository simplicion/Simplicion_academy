// Simplicion Academy Multi-Tenant Data Schema
// Conforms to SAFS-02 Data Standards & PRD Section 10

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// Platform Level (Cross-Tenant Governance)
// ----------------------------------------------------

model Plan {
  id              String         @id @default(uuid())
  name            String         // "Free/Trial", "Pro", "Business"
  slug            String         @unique
  maxStudents     Int            @default(50)
  storageGb       Int            @default(5)
  staffSeats      Int            @default(1)
  customDomain    Boolean        @default(false)
  transactionFee  Float          @default(10.0) // percentage
  modulesAllowed  String[]       @default(["doubtSupport", "whatsappCommunity"])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  tenants         Tenant[]
}

model Tenant {
  id              String         @id @default(uuid())
  slug            String         @unique
  name            String
  status          String         @default("draft") // "draft" | "active" | "suspended"
  planId          String
  plan            Plan           @relation(fields: [planId], references: [id])
  ownerUserId     String
  customDomain    String?        @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  settings        TenantSettings?
  memberships     TenantMembership[]
  categories      Category[]
  offerings       Offering[]
  orders          Order[]
  otpRequests     OtpRequest[]

  @@index([slug])
  @@index([customDomain])
}

model TenantSettings {
  id              String         @id @default(uuid())
  tenantId        String         @unique
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branding        Json           // { logoUrl, faviconUrl, tagline, primaryColor, accentColor, borderRadius, fontFamily, headerLayout }
  labels          Json           // { studyEntry, unitsHeader, offeringName }
  sectionsOrder   String[]       @default(["hero", "upcoming-slider", "categories", "why-us", "testimonials", "faq"])
  enabledModules  Json           // { doubtSupport, mentorship, whatsappCommunity, advisoryTools }
  contact         Json           // { supportPhone, whatsappNumber, whatsappTemplate }
  seo             Json           // { titleTemplate, metaDescription, keywords, ogImageUrl }
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

// ----------------------------------------------------
// User & Identity
// ----------------------------------------------------

model User {
  id              String         @id @default(uuid())
  phone           String         @unique
  email           String?        @unique
  name            String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  memberships     TenantMembership[]
  enrollments     Enrollment[]
  orders          Order[]
  attempts        Attempt[]
}

model TenantMembership {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            String         @default("student") // "student" | "teacher" | "staff" | "admin"
  createdAt       DateTime       @default(now())

  @@unique([tenantId, userId])
  @@index([tenantId])
}

model OtpRequest {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phone           String
  codeHash        String
  expiresAt       DateTime
  attempts        Int            @default(0)
  isVerified      Boolean        @default(false)
  createdAt       DateTime       @default(now())

  @@index([tenantId, phone])
}

// ----------------------------------------------------
// Educational Catalog & Content (Tenant-Scoped)
// ----------------------------------------------------

model Category {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  slug            String
  icon            String?
  order           Int            @default(0)
  isActive        Boolean        @default(true)
  description     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  offerings       Offering[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Offering {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id])
  type            String         @default("batch") // "batch" | "course" | "test_series" | "free_resource" | "bundle"
  title           String
  slug            String
  description     String
  startDate       DateTime?
  endDate         DateTime?
  language        String         @default("bilingual")
  bannerUrl       String?
  status          String         @default("draft") // "draft" | "upcoming" | "live" | "archived"
  visibility      String         @default("public") // "public" | "unlisted" | "private"
  mrp             Float          @default(0.0)
  salePrice       Float          @default(0.0)
  capacity        Int?
  freePreviewCaps Json           @default("{\"demoClasses\":1,\"sampleTests\":1,\"samplePapers\":1}")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  features        OfferingFeature[]
  units           OfferingUnit[]
  enrollments     Enrollment[]
  orders          Order[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([categoryId])
}

model OfferingFeature {
  id              String         @id @default(uuid())
  offeringId      String
  offering        Offering       @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  icon            String
  text            String
  order           Int            @default(0)

  @@index([offeringId])
}

model Unit {
  id              String         @id @default(uuid())
  tenantId        String
  name            String
  slug            String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  offeringUnits   OfferingUnit[]
  contentItems    ContentItem[]

  @@index([tenantId])
}

model OfferingUnit {
  id              String         @id @default(uuid())
  offeringId      String
  offering        Offering       @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  unitId          String
  unit            Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  order           Int            @default(0)

  @@unique([offeringId, unitId])
}

model ContentItem {
  id              String         @id @default(uuid())
  tenantId        String
  unitId          String
  unit            Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  type            String         // "class_video" | "notes_pdf" | "mock_test" | "cbt_test" | "previous_paper" | "current_affairs"
  title           String
  assetUrl        String?
  isFreePreview   Boolean        @default(false)
  order           Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tests           Test[]

  @@index([tenantId])
  @@index([unitId])
}

// ----------------------------------------------------
// CBT Assessment Engine
// ----------------------------------------------------

model Test {
  id              String         @id @default(uuid())
  tenantId        String
  contentItemId   String?
  contentItem     ContentItem?   @relation(fields: [contentItemId], references: [id])
  title           String
  durationMinutes Int            @default(60)
  totalMarks      Float          @default(100.0)
  createdAt       DateTime       @default(now())

  questions       Question[]
  attempts        Attempt[]

  @@index([tenantId])
}

model Question {
  id              String         @id @default(uuid())
  testId          String
  test            Test           @relation(fields: [testId], references: [id], onDelete: Cascade)
  type            String         @default("single_choice")
  textEn          String
  textHi          String?
  options         Json           // [{ id, textEn, textHi }]
  correctOptionIds String[]
  marks           Float          @default(4.0)
  negativeMarks   Float          @default(1.0)
  explanationEn   String?
  explanationHi   String?
  order           Int            @default(0)

  @@index([testId])
}

model Attempt {
  id              String         @id @default(uuid())
  tenantId        String
  testId          String
  test            Test           @relation(fields: [testId], references: [id], onDelete: Cascade)
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          String         @default("in_progress") // "in_progress" | "submitted" | "timed_out"
  answers         Json           // { questionId: { selectedOptionIds, timeSpentSeconds } }
  scorecard       Json?          // { attempted, correct, incorrect, totalMarksScored, percentageScore }
  startedAt       DateTime       @default(now())
  submittedAt     DateTime?

  @@index([tenantId, userId])
  @@index([testId])
}

// ----------------------------------------------------
// Commerce & Enrollments
// ----------------------------------------------------

model Order {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  offeringId      String
  offering        Offering       @relation(fields: [offeringId], references: [id])
  grossAmount     Float
  platformFee     Float
  teacherPayout   Float
  status          String         @default("pending") // "pending" | "paid" | "failed" | "refunded"
  gatewayOrderId  String?
  gatewayPaymentId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([tenantId, userId])
  @@index([gatewayOrderId])
}

model Enrollment {
  id              String         @id @default(uuid())
  tenantId        String
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  offeringId      String
  offering        Offering       @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  source          String         @default("paid") // "paid" | "entitlement" | "admin"
  grantedAt       DateTime       @default(now())

  @@unique([userId, offeringId])
  @@index([tenantId, userId])
}

// ----------------------------------------------------
// Lead Capture & 180 Pay Settlement Logs (Supabase)
// ----------------------------------------------------

model Lead {
  id              String         @id @default(uuid())
  tenantSlug      String
  categorySlug    String
  categoryName    String
  phone           String
  email           String?
  createdAt       DateTime       @default(now())

  @@index([tenantSlug, categorySlug])
}

model One80Transaction {
  id              String         @id @default(uuid())
  orderId         String         @unique
  sessionId       String?
  tenantSlug      String
  offeringId      String
  offeringTitle   String
  amount          Float          // Whole currency units per 180 Pay spec
  currency        String         @default("INR")
  teacherPayout   Float
  platformFee     Float
  status          String         @default("created") // "created" | "paid" | "failed"
  mode            String         @default("live")    // "live" | "sandbox"
  checkoutUrl     String?
  studentName     String?
  studentEmail    String?
  studentPhone    String?
  transactionId   String?
  paidAt          DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([tenantSlug])
  @@index([offeringId])
}

// ----------------------------------------------------
// Dedicated Course Workspace, Live Classes, Chat, Doubts & Notifications
// ----------------------------------------------------

model StudioCourse {
  id              String              @id @default(uuid())
  tenantSlug      String
  slug            String
  title           String
  description     String?
  priceInr        Float               @default(0)
  maxStudents     Int?                // null = unlimited seats
  bannerUrl       String?
  isSetupComplete Boolean             @default(false)
  status          String              @default("draft") // "draft" | "live"
  launchedAt      DateTime?
  chatMuted       Boolean             @default(false)
  chatSlowMode    Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  subjects        CourseSubject[]
  liveSessions    LiveSession[]
  enrollments     CourseEnrollment[]
  chatMessages    CourseChatMessage[]
  doubts          CourseDoubt[]
  tests           CourseTest[]

  @@unique([tenantSlug, slug])
  @@index([tenantSlug, status])
}

model CourseSubject {
  id              String         @id @default(uuid())
  courseId        String
  course          StudioCourse   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tenantSlug      String
  title           String
  description     String?
  order           Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  lessons         CourseLesson[]

  @@index([courseId])
  @@index([tenantSlug])
}

model CourseLesson {
  id              String         @id @default(uuid())
  subjectId       String
  subject         CourseSubject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  courseId        String
  tenantSlug      String
  title           String
  order           Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  topics          CourseTopic[]

  @@index([subjectId])
  @@index([courseId])
}

model CourseTopic {
  id              String         @id @default(uuid())
  lessonId        String
  lesson          CourseLesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  courseId        String
  tenantSlug      String
  title           String
  textContent     String?
  youtubeUrl      String?
  docLinks        Json           @default("[]") // [{ id, label, url }]
  order           Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([lessonId])
  @@index([courseId])
}

model LiveSession {
  id              String                  @id @default(uuid())
  courseId        String
  course          StudioCourse            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tenantSlug      String
  subjectId       String?
  subjectTitle    String?
  lessonId        String?
  lessonTitle     String?
  topicId         String?
  topicTitle      String?
  title           String
  youtubeLiveUrl  String
  attachedDocs    Json                    @default("[]") // [{ id, label, url }]
  scheduledAt     DateTime                @default(now())
  status          String                  @default("live") // "scheduled" | "live" | "ended"
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime                @default(now())

  attendances     LiveSessionAttendance[]

  @@index([courseId, status])
  @@index([tenantSlug])
}

model LiveSessionAttendance {
  id              String         @id @default(uuid())
  sessionId       String
  session         LiveSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  courseId        String
  tenantSlug      String
  studentId       String
  studentName     String
  studentEmail    String?
  joinedAt        DateTime       @default(now())
  lastSeenAt      DateTime       @default(now())

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([tenantSlug])
}

model CourseEnrollment {
  id              String         @id @default(uuid())
  courseId        String
  course          StudioCourse   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tenantSlug      String
  studentId       String
  studentName     String
  studentEmail    String?
  amountPaid      Float          @default(0)
  paymentId       String?
  enrolledAt      DateTime       @default(now())

  @@unique([courseId, studentId])
  @@index([tenantSlug, studentId])
  @@index([courseId, enrolledAt])
}

model TopicCompletion {
  id              String         @id @default(uuid())
  courseId        String
  topicId         String
  studentId       String
  completedAt     DateTime       @default(now())

  @@unique([topicId, studentId])
  @@index([courseId, studentId])
}

model CourseChatMessage {
  id              String         @id @default(uuid())
  courseId        String
  course          StudioCourse   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  liveSessionId   String?
  tenantSlug      String
  senderId        String
  senderName      String
  senderRole      String         @default("student") // "student" | "teacher"
  message         String
  isPinned        Boolean        @default(false)
  createdAt       DateTime       @default(now())

  @@index([courseId, createdAt])
}

model CourseDoubt {
  id                 String         @id @default(uuid())
  courseId           String
  course             StudioCourse   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tenantSlug         String
  subjectId          String?
  lessonId           String?
  topicId            String?
  lessonContextLabel String         @default("General Course")
  studentId          String
  studentName        String
  studentEmail       String?
  question           String
  reply              String?
  repliedAt          DateTime?
  isPinnedFaq        Boolean        @default(false)
  status             String         @default("open") // "open" | "answered"
  createdAt          DateTime       @default(now())

  @@index([courseId, status])
  @@index([courseId, lessonId])
  @@index([studentId])
}

model StudentNotification {
  id              String         @id @default(uuid())
  tenantSlug      String
  studentId       String
  courseId        String?
  type            String         // "doubt_reply" | "live_started" | "enrollment"
  title           String
  body            String
  linkUrl         String?
  isRead          Boolean        @default(false)
  createdAt       DateTime       @default(now())

  @@index([studentId, isRead])
  @@index([tenantSlug, studentId])
}

model CourseTest {
  id              String               @id @default(uuid())
  courseId        String
  course          StudioCourse         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tenantSlug      String
  title           String
  description     String?
  durationMinutes Int                  @default(30)
  status          String               @default("live") // "live" | "draft"
  scope           String               @default("course") // "course" | "subject" | "lesson"
  subjectId       String?
  subjectTitle    String?
  lessonId        String?
  lessonTitle     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  questions       CourseTestQuestion[]
  attempts        CourseTestAttempt[]

  @@index([courseId, status])
  @@index([courseId, subjectId])
  @@index([courseId, lessonId])
}

model CourseTestQuestion {
  id               String     @id @default(uuid())
  testId           String
  test             CourseTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  courseId         String
  type             String     @default("single_choice")
  prompt           String
  promptHindi      String?
  options          Json       @default("[]")
  correctOptionIds String[]
  maxLength        Int?
  placeholder      String?
  expectedAnswer   String?
  marks            Float      @default(4.0)
  negativeMarks    Float      @default(1.0)
  explanation      String?
  order            Int        @default(0)
  createdAt        DateTime   @default(now())

  @@index([testId, order])
}

model CourseTestAttempt {
  id               String     @id @default(uuid())
  testId           String
  test             CourseTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  courseId         String
  studentId        String
  studentName      String
  answers          Json
  scorecard        Json
  totalMarksScored Float      @default(0)
  maxMarks         Float      @default(0)
  percentageScore  Float      @default(0)
  submittedAt      DateTime   @default(now())

  @@index([testId, studentId])
  @@index([courseId, studentId])
}


