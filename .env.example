# ==============================================================================
# Simplicion Academy Multi-Tenant Enterprise Platform Environment Variables
# Conforming to SAFS-01, SAFS-02 & PRD v2.0
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Delivery Gateway Service (apps/api)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000
BASE_DOMAIN=simplicion.com

# ------------------------------------------------------------------------------
# 2. Database & Platform Layer (Supabase PostgreSQL, Storage & Realtime)
# ------------------------------------------------------------------------------
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.fzogbyhgufiaywcctjkp:<YOUR_DB_PASSWORD>@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.fzogbyhgufiaywcctjkp:<YOUR_DB_PASSWORD>@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres"
SUPABASE_URL=https://fzogbyhgufiaywcctjkp.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_fPvXzQwl8w7V0T1Z1jmtNw_YDsTBC_u
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
SUPABASE_JWKS_URL=https://fzogbyhgufiaywcctjkp.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_STORAGE_BUCKET=simplicion-academy-assets
NEXT_PUBLIC_SUPABASE_URL=https://fzogbyhgufiaywcctjkp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_fPvXzQwl8w7V0T1Z1jmtNw_YDsTBC_u

