# ==============================================================================
# Simplicion Academy Multi-Tenant Enterprise Platform Environment Variables
# Conforming to SAFS-01, SAFS-02 & PRD v2.0
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Delivery Gateway Service (apps/api)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000
BASE_DOMAIN=simplicion.com

# ------------------------------------------------------------------------------
# 2. Database Persistence Layer (PostgreSQL 16 via packages/db & Prisma)
# ------------------------------------------------------------------------------
POSTGRES_USER=simplicion
POSTGRES_PASSWORD=simplicion_dev_pass_2026
POSTGRES_DB=simplicion_academy
POSTGRES_PORT=5432
DATABASE_URL=postgresql://simplicion:simplicion_dev_pass_2026@localhost:5432/simplicion_academy?schema=public

# ------------------------------------------------------------------------------
# 3. Redis In-Memory Cache & Rate Limiting
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 4. Enterprise JWT Security & Secret Keys (RFC 7519)
# ------------------------------------------------------------------------------
JWT_SECRET=jwt_simplicion_enterprise_secret_2026

# ------------------------------------------------------------------------------
# 5. Razorpay Route Split Settlement Payment Gateway
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_simplicion_2026
RAZORPAY_KEY_SECRET=rzp_secret_mock_2026
RAZORPAY_WEBHOOK_SECRET=rzp_whsec_simplicion_2026

# ------------------------------------------------------------------------------
# 6. Cloud Object Storage (Cloudflare R2 / AWS S3)
# ------------------------------------------------------------------------------
STORAGE_ENDPOINT=https://storage.simplicion.com
STORAGE_SECRET=simplicion_storage_secret_2026
STORAGE_BUCKET=simplicion-academy-assets

# ------------------------------------------------------------------------------
# 7. SMS / WhatsApp OTP Notification Gateways
# ------------------------------------------------------------------------------
SMS_GATEWAY_PROVIDER=mock # mock | fast2sms | msg91 | twilio
SMS_GATEWAY_API_KEY=mock_sms_api_key_2026

